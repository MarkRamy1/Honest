# Application
APP_NAME="Honest AI"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security
SECRET_KEY=change_this_to_a_secure_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Database (PostgreSQL URL)
# Example: postgresql+psycopg://username:password@localhost:5432/honest_db
# For lightweight local testing without a live PostgreSQL instance, sqlite is also supported:
# DATABASE_URL=sqlite:///./honest_local.db
DATABASE_URL=postgresql+psycopg://honest:honest_secret@localhost:5432/honest_db

# Multi-Provider AI Architecture
# Options for AI_PROVIDER: "mock" (default/test), "gemini", "openai"
AI_PROVIDER=mock
# Configurable model ID (e.g., "gemini-2.5-flash", "gemini-1.5-pro", "gemini-4-argon", "gpt-4o", "gpt-4o-mini")
AI_MODEL=gemini-2.5-flash

# Google Gemini API Credentials
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenAI API Credentials
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# External Search Grounding & Discovery (Optional)
ENABLE_WEB_SEARCH_GROUNDING=true
TAVILY_API_KEY=
SERPAPI_API_KEY=

# Currency and Exchange Rate Configuration
EXCHANGE_RATE_API_URL=
USD_TO_EGP_FALLBACK=49.50

# Execution Budgets & Limits
MAX_SEARCH_ITERATIONS=3
MAX_TOOL_CALLS=6
EXTERNAL_REQUEST_TIMEOUT_SECONDS=12.0
MAX_SEARCH_BUDGET_USD=5.0

